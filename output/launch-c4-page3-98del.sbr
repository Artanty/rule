<dict>
    <key>StreamByter-Rules</key>
    <string># launch-c4-page3-98del
# Generated: 05.05.2026, 14:24:45

# == RULE 1: [launch for c4 - knobs] knob 1 [0-17] → [c4 octave] voice 1 octave -3 (1) ==
# trigger-source: [mapping] "launch for c4 - knobs"
# consumer-source: [mapping] "c4 octave"
IF M0 == B1 29
  IF M2 &gt;= 0x0
    IF M2 &lt;= 0x11
    ASS M0 = B1
    ASS M1 = 17
    ASS M2 = 01
    SND M0 M1 M2
  END
  END
END

