<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StreamByter-Rules</key>
    <string># launch-c4-page3
# Generated: 11.04.2026, 19:30:40
# Override trigger channel: 2

# == RULE 1: [c4] master treble → [c4] voice 1 octave ==
IF M0 == B1 29
  ASS M0 = B1
  ASS M1 = 17
  SND M0 M1 M2
  BLOCK
END

# == RULE 2: [c4] voice 1 source → [c4] voice 2 octave ==
IF M0 == B1 2A
  ASS M0 = B1
  ASS M1 = 18
  SND M0 M1 M2
  BLOCK
END

# == RULE 3: [c4] voice 2 source → [c4] voice 3 octave ==
IF M0 == B1 2B
  ASS M0 = B1
  ASS M1 = 19
  SND M0 M1 M2
  BLOCK
END

# == RULE 4: [c4] voice 3 source → [c4] voice 4 octave ==
IF M0 == B1 2C
  ASS M0 = B1
  ASS M1 = 1A
  SND M0 M1 M2
  BLOCK
END

# == RULE 5: [c4] voice 4 source → [c4] voice 1 semitone ==
IF M0 == B1 2D
  ASS M0 = B1
  ASS M1 = 13
  SND M0 M1 M2
  BLOCK
END

# == RULE 6: [c4] voice 1 destination → [c4] voice 2 semitone ==
IF M0 == B1 2E
  ASS M0 = B1
  ASS M1 = 14
  SND M0 M1 M2
  BLOCK
END

# == RULE 7: [c4] voice 2 destination → [c4] voice 3 semitone ==
IF M0 == B1 2F
  ASS M0 = B1
  ASS M1 = 15
  SND M0 M1 M2
  BLOCK
END

# == RULE 8: [c4] voice 3 destination → [c4] voice 4 semitone ==
IF M0 == B1 30
  ASS M0 = B1
  ASS M1 = 16
  SND M0 M1 M2
  BLOCK
END
</string>
</dict>
</plist>