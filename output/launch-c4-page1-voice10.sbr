<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StreamByter-Rules</key>
    <string># launch-c4-page1-voice10
# Generated: 14.05.2026, 15:34:20

# == RULE 1: [launch for c4 - knobs] knob 1 [0-63] → [c4 voice] voice 1 off (0) ==
# trigger-source: [mapping] "launch for c4 - knobs"
# consumer-source: [mapping] "c4 voice"
IF M0 == B1 29
  IF M2 &gt;= 0x0
    IF M2 &lt;= 0x3F
    ASS M0 = B1
    ASS M1 = 00
    ASS M2 = 00
    SND M0 M1 M2
  END
  END
END

# == RULE 2: [launch for c4 - knobs] knob 1 [64-127] → [c4 voice] voice 1 on (1) ==
# trigger-source: [mapping] "launch for c4 - knobs"
# consumer-source: [mapping] "c4 voice"
IF M0 == B1 29
  IF M2 &gt;= 0x40
    IF M2 &lt;= 0x7F
    ASS M0 = B1
    ASS M1 = 00
    ASS M2 = 01
    SND M0 M1 M2
  END
  END
END

# == RULE 3: [c4] voice 1 enable = 0 → [c4 voice tgl+lvl view] voice 1 off (0) ==
# trigger-source: [device] "2"
# consumer-source: [mapping] "c4 voice tgl+lvl view"
IF M0 == B1 00 00
  ASS M0 = B9
  ASS M1 = 00
  ASS M2 = 00
  SND M0 M1 M2
  BLOCK
END

# == RULE 4: [c4] voice 1 enable = 1 → [c4 voice tgl+lvl view] voice 1 on (127) ==
# trigger-source: [device] "2"
# consumer-source: [mapping] "c4 voice tgl+lvl view"
