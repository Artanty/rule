<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StreamByter-Rules</key>
    <string># launch-c4-page3-113
# Generated: 05.05.2026, 18:33:56

# First rule: Send a message AND keep the original
IF M0 == B1 29
  BX 29 = XX 30 +C
  SND B9 02 7F
END

# Second rule: This will catch the ORIGINAL message (B1 29)
IF M0 == B1 29
  # Do something else with the original
  SND B9 01 7F
END

</string>
</dict>
</plist>