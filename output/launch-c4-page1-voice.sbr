<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StreamByter-Rules</key>
    <string># launch-c4-page1-voice
# Generated: 08.05.2026, 16:24:49

# == RULE 1: [launch] knob 1 [0-63] → [c4 voice] voice 1 off (0) ==
# trigger-source: [device] "1"
# consumer-source: [mapping] "c4 voice"
IF M0 == B0 29
  IF M2 &gt;= 0x0
    IF M2 &lt;= 0x3F
    ASS M0 = B1
    ASS M1 = 00
    ASS M2 = 00
    SND M0 M1 M2
    BLOCK
  END
  END
END

# == RULE 2: [launch] knob 1 [64-127] → [c4 voice] voice 1 on (1) ==
# trigger-source: [device] "1"
# consumer-source: [mapping] "c4 voice"
IF M0 == B0 29
  IF M2 &gt;= 0x40
    IF M2 &lt;= 0x7F
    ASS M0 = B1
    ASS M1 = 00
    ASS M2 = 01
    SND M0 M1 M2
    BLOCK
  END
  END
END

# == RULE 3: [launch] knob 2 [0-63] → [c4 voice] voice 2 off (0) ==
# trigger-source: [device] "1"
# consumer-source: [mapping] "c4 voice"
IF M0 == B0 2A
  IF M2 &gt;= 0x0
    IF M2 &lt;= 0x3F
    ASS M0 = B1
    ASS M1 = 01
    ASS M2 = 00
    SND M0 M1 M2
  END
  END
END

# == RULE 4: [launch] knob 2 [64-127] → [c4 voice] voice 2 off (0) ==
# trigger-source: [device] "1"
# consumer-source: [mapping] "c4 voice"
IF M0 == B0 2A
  IF M2 &gt;= 0x40
    IF M2 &lt;= 0x7F
    ASS M0 = B1
    ASS M1 = 01
    ASS M2 = 00
    SND M0 M1 M2
  END
  END
END

# == RULE 5: [launch] knob 5 → [c4] voice 1 level ==
# trigger-source: [device] "1"
# consumer-source: [device] "2"
IF M0 == B0 2D
  ASS M0 = B1
  ASS M1 = 04
  SND M0 M1 M2
  BLOCK
END

# == RULE 6: [launch] knob 6 → [c4] voice 2 level ==
# trigger-source: [device] "1"
# consumer-source: [device] "2"
IF M0 == B0 2E
  ASS M0 = B1
  ASS M1 = 05
  SND M0 M1 M2
END
</string>
</dict>
</plist>