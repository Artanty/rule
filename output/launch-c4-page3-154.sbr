<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StreamByter-Rules</key>
    <string># launch-c4-page3-154
# Generated: 06.05.2026, 22:47:41

# == RULE 1: [launch for c4 - knobs] knob 1 → [loopy] util (1) [+I] ==
# trigger-source: [mapping] "launch for c4 - knobs"
# consumer-source: [device] "10"
IF M0 == B1 29
  SND B9 7F 01 +I
END

# == RULE 2: [launch for c4 - knobs] knob 1 [0-17] → [c4 octave] voice 1 octave -3 (1) ==
# trigger-source: [mapping] "launch for c4 - knobs"
# consumer-source: [mapping] "c4 octave"
IF M0 == B1 29
  IF M2 &gt;= 0x0
    IF M2 &lt;= 0x11
    ASS M0 = B1
    ASS M1 = 17
    ASS M2 = 01
    SND M0 M1 M2
  END
  END
END

# == RULE 3: [launch for c4 - knobs] knob 1 [18-35] → [c4 octave] voice 1 octave -2 (2) ==
# trigger-source: [mapping] "launch for c4 - knobs"
# consumer-source: [mapping] "c4 octave"
IF M0 == B1 29
  IF M2 &gt;= 0x12
    IF M2 &lt;= 0x23
    ASS M0 = B1
    ASS M1 = 17
    ASS M2 = 02
    SND M0 M1 M2
  END
  END
END

# == RULE 4: [launch for c4 - knobs] knob 1 [36-53] → [c4 octave] voice 1 octave -1 (3) ==
# trigger-source: [mapping] "launch for c4 - knobs"
# consumer-source: [mapping] "c4 octave"
IF M0 == B1 29
  IF M2 &gt;= 0x24
    IF M2 &lt;= 0x35
    ASS M0 = B1
    ASS M1 = 17
    ASS M2 = 03
    SND M0 M1 M2
  END
  END
END

# == RULE 5: [launch for c4 - knobs] knob 1 [54-71] → [c4 octave] voice 1 octave 0 (4) ==
# trigger-source: [mapping] "launch for c4 - knobs"
# consumer-source: [mapping] "c4 octave"
IF M0 == B1 29
  IF M2 &gt;= 0x36
    IF M2 &lt;= 0x47
    ASS M0 = B1
    ASS M1 = 17
    ASS M2 = 04
    SND M0 M1 M2
  END
  END
END

# == RULE 6: [launch for c4 - knobs] knob 1 [72-89] → [c4 octave] voice 1 octave +1 (5) ==
# trigger-source: [mapping] "launch for c4 - knobs"
# consumer-source: [mapping] "c4 octave"
IF M0 == B1 29
  IF M2 &gt;= 0x48
    IF M2 &lt;= 0x59
    ASS M0 = B1
    ASS M1 = 17
    ASS M2 = 05
    SND M0 M1 M2
  END
  END
END

# == RULE 7: [launch for c4 - knobs] knob 1 [90-107] → [c4 octave] voice 1 octave +2 (6) ==
# trigger-source: [mapping] "launch for c4 - knobs"
# consumer-source: [mapping] "c4 octave"
IF M0 == B1 29
  IF M2 &gt;= 0x5A
    IF M2 &lt;= 0x6B
    ASS M0 = B1
    ASS M1 = 17
    ASS M2 = 06
    SND M0 M1 M2
  END
  END
END

# == RULE 8: [launch for c4 - knobs] knob 1 [108-127] → [c4 octave] voice 1 octave +3 (7) ==
# trigger-source: [mapping] "launch for c4 - knobs"
# consumer-source: [mapping] "c4 octave"
IF M0 == B1 29
  IF M2 &gt;= 0x6C
    IF M2 &lt;= 0x7F
    ASS M0 = B1
    ASS M1 = 17
    ASS M2 = 07
    SND M0 M1 M2
  END
  END
END

# == RULE 9: [c4] voice 1 octave = 1 → [c4 octave view] voice 1 octave -3 (0) ==
# trigger-source: [device] "2"
# consumer-source: [mapping] "c4 octave view"
IF M0 == B1 17 01
  ASS M0 = B9
  ASS M1 = 01
  ASS M2 = 00
  SND M0 M1 M2
  BLOCK
END

# == RULE 10: [loopy] util = 1 → [c4 voices view] touch voice 1 (0) ==
# trigger-source: [device] "10"
# consumer-source: [mapping] "c4 voices view"
IF M0 == B9 7F 01
  ASS M0 = B9
  ASS M1 = 00
  ASS M2 = 00
  SND M0 M1 M2
  BLOCK
END
</string>
</dict>
</plist>