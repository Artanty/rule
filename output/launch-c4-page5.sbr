<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StreamByter-Rules</key>
    <string># launch-c4-page5
# Generated: 11.04.2026, 21:10:36
# Override trigger channel: [1-&gt;2]

# == RULE 1: [launch] knob 1 → [c4] voice 1 processor pan ==
IF M0 == B1 29
  ASS M0 = B1
  ASS M1 = 32
  SND M0 M1 M2
  BLOCK
END

# == RULE 2: [launch] knob 2 → [c4] voice 2 processor pan ==
IF M0 == B1 2A
  ASS M0 = B1
  ASS M1 = 33
  SND M0 M1 M2
  BLOCK
END

# == RULE 3: [launch] knob 3 → [c4] voice 3 processor pan ==
IF M0 == B1 2B
  ASS M0 = B1
  ASS M1 = 34
  SND M0 M1 M2
  BLOCK
END

# == RULE 4: [launch] knob 4 → [c4] voice 4 processor pan ==
IF M0 == B1 2C
  ASS M0 = B1
  ASS M1 = 35
  SND M0 M1 M2
  BLOCK
END

# == RULE 5: [launch] knob 5 → [c4] voice 1 tremolo ==
IF M0 == B1 2D
  ASS M0 = B1
  ASS M1 = 36
  SND M0 M1 M2
  BLOCK
END

# == RULE 6: [launch] knob 6 → [c4] voice 2 tremolo ==
IF M0 == B1 2E
  ASS M0 = B1
  ASS M1 = 37
  SND M0 M1 M2
  BLOCK
END

# == RULE 7: [launch] knob 7 → [c4] voice 3 tremolo ==
IF M0 == B1 2F
  ASS M0 = B1
  ASS M1 = 38
  SND M0 M1 M2
  BLOCK
END

# == RULE 8: [launch] knob 8 → [c4] voice 4 tremolo ==
IF M0 == B1 30
  ASS M0 = B1
  ASS M1 = 39
  SND M0 M1 M2
  BLOCK
END
</string>
</dict>
</plist>