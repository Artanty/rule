  ASS M0 = B1
  ASS M1 = 0C
  SND M0 M1 M2
  BLOCK
END

# == RULE 5: [launch] knob 5 → [c4] voice 1 envelope ==
IF M0 == B1 2D
  ASS M0 = B1
  ASS M1 = 1B
  SND M0 M1 M2
  BLOCK
END

# == RULE 6: [launch] knob 6 → [c4] voice 2 envelope ==
IF M0 == B1 2E
  ASS M0 = B1
  ASS M1 = 1C
  SND M0 M1 M2
  BLOCK
END

# == RULE 7: [launch] knob 7 → [c4] voice 3 envelope ==
