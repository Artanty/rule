<dict>
    <key>StreamByter-Rules</key>
    <string># StreamByter Script generated by MIDI Messenger
# Generated: 11.04.2026, 19:07:04
# Override trigger channel: 2

# == RULE 1: [launch] knob 1 → [c4] voice 1 mode ==
IF M0 == B1 29
  ASS M0 = B1
  ASS M1 = 09
  SND M0 M1 M2
  BLOCK
END

# == RULE 2: [launch] knob 2 → [c4] voice 2 mode ==
