  ASS M0 = B1
  ASS M1 = 1D
  SND M0 M1 M2
  BLOCK
END

# == RULE 8: [launch] knob 8 → [c4] voice 4 envelope ==
IF M0 == B1 30
  ASS M0 = B1
  ASS M1 = 1E
  SND M0 M1 M2
  BLOCK
END
</string>
</dict>
