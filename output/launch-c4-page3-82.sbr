# == CUSTOM_RULE ==
# every knob decreased by 1 and sent to ch10 for view
# if ch2 cc23 val77 -&gt; ch10 cc23 val76
# send mock ch10 cc23 val0 inject.
IF M0 == B1 17
  IF M2 &gt; 0
    MAT M2 = M2 - 1
    SND B9 17 M2
    BLOCK
    SND B9 17 +I
  END
END

# == RULE 8: [Channel 10] CC#23 → [c4 loopy view] touch voice 1+ (0) ==
# trigger-source: [channel] "10"
# consumer-source: [mapping] "c4 loopy view"
IF M0 == B9 17
  ASS M0 = B9
  ASS M1 = 00
  ASS M2 = 00
  SND M0 M1 M2
  BLOCK
END

