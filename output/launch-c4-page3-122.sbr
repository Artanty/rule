<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StreamByter-Rules</key>
    <string># launch-c4-page3-118
# Generated: 05.05.2026, 19:56:10

# == RULE 1: unchanged ==
IF M0 == B1 29
  IF M2 >= 0x0
    IF M2 <= 0x11
      ASS M0 = B1
      ASS M1 = 17
      ASS M2 = 01
      SND M0 M1 M2
    END
  END
END

# == RULE 2: add +C to clone so RULE 3 can also see B1 17 01 ==
IF M0 == B1 17 01
  ASS M0 = B9
  ASS M1 = 01
  ASS M2 = 00
  SND M0 M1 M2 +C   # ← +C clones the current message (B1 17 01)
END

# == RULE 3: will now catch the clone ==
IF M0 == B1 17 01
  ASS M0 = B9
  ASS M1 = 00
  ASS M2 = 00
  SND M0 M1 M2
END
</string>
</dict>
</plist>