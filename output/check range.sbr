<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StreamByter-Rules</key>
    <string># check range
# Generated: 06.05.2026, 21:42:21

# == RULE 1: [launch] CC#7 [0-127] → [Channel 1] Note#60 (vel 100) ==
# trigger-source: [device] "1"
# consumer-source: [channel] "1"
IF M0 == B0 07
  IF M2 &gt;= 0x0
    IF M2 &lt;= 0x7F
    ASS M0 = 90
    ASS M1 = 3C
    ASS M2 = 64
    SND M0 M1 M2
    BLOCK
  END
  END
END
</string>
</dict>
</plist>