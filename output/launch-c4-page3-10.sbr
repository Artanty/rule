<dict>
    <key>StreamByter-Rules</key>
    <string># launch-c4-page3-10
# Generated: 18.04.2026, 17:32:29
# Override trigger channel: [1-&gt;2]

# == RULE 1: [launch] knob 1 [0-17] → [c4] voice 1 octave ==
IF M0 == B1 29
  IF M2 &gt;= 0x0
    IF M2 &lt;= 0x11
    ASS M0 = B1
    ASS M1 = 17
    ASS M2 = 01
    SND M0 M1 M2
  END
  END
END

