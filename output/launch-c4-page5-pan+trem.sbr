<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StreamByter-Rules</key>
    <string># launch-c4-page5-pan+trem
# Generated: 14.05.2026, 15:53:24

# == RULE 1: [launch for c4 - knobs] master treble → [c4] voice 1 processor pan ==
# trigger-source: [mapping] "launch for c4 - knobs"
# consumer-source: [device] "2"
IF M0 == B1 29
  ASS M0 = B1
  ASS M1 = 32
  SND M0 M1 M2
END

# == RULE 2: [c4] voice 1 processor pan → [Channel 10] CC#50 ==
# trigger-source: [device] "2"
# consumer-source: [channel] "10"
IF M0 == B1 32
  ASS M0 = B9
  ASS M1 = 32
  SND M0 M1 M2
  BLOCK
END

# == RULE 3: [launch for c4 - knobs] voice 1 source → [c4] voice 2 processor pan ==
