<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StreamByter-Rules</key>
    <string># StreamByter Script
# Generated: 27.04.2026, 15:44:13

# == RULE 1: [launch] knob 1 → [lp c4 page 3] voice 1 ==
# trigger-source: [device] "1"
# consumer-source: [mapping] "lp c4 page 3"
IF M0 == B0 29
  ASS M0 = C1
  ASS M1 = 6F
  SND M0 M1
  BLOCK
END

# == RULE 2: [Channel 2] any note → [Channel 2] voice 3 mode ==
# trigger-source: [channel] "2"
# consumer-source: [channel] "2"
IF M0 &gt;= 0x90 &amp;&amp; M0 &lt;= 0x9F
  ASS M0 = B1
  ASS M1 = 0B
  SND M0 M1 M2
END
</string>
</dict>
</plist>