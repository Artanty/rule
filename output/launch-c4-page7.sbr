<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StreamByter-Rules</key>
    <string># launch-c4-page7
# Generated: 11.04.2026, 22:38:26
# Override trigger channel: [1-&gt;2]

# == RULE 1: [launch] knob 1 → [c4] master input 1 gain ==
IF M0 == B1 29
  ASS M0 = B1
  ASS M1 = 0E
  SND M0 M1 M2
  BLOCK
END

# == RULE 2: [launch] knob 2 → [c4] master input 2 gain ==
IF M0 == B1 2A
  ASS M0 = B1
  ASS M1 = 26
  SND M0 M1 M2
  BLOCK
END

# == RULE 3: [launch] knob 3 → [c4] master depth ==
IF M0 == B1 2B
  ASS M0 = B1
  ASS M1 = 1F
  SND M0 M1 M2
  BLOCK
END

# == RULE 4: [launch] knob 4 → [c4] master mod source ==
IF M0 == B1 2C
  ASS M0 = B1
  ASS M1 = 27
  SND M0 M1 M2
  BLOCK
END

# == RULE 5: [launch] knob 5 → [c4] master bass ==
IF M0 == B1 2D
  ASS M0 = B1
  ASS M1 = 28
  SND M0 M1 M2
  BLOCK
END

# == RULE 6: [launch] knob 6 → [c4] master treble ==
IF M0 == B1 2E
  ASS M0 = B1
  ASS M1 = 29
  SND M0 M1 M2
  BLOCK
END

# == RULE 7: [launch] knob 7 → [c4] master output level ==
IF M0 == B1 2F
  ASS M0 = B1
  ASS M1 = 0D
  SND M0 M1 M2
  BLOCK
END
</string>
</dict>
</plist>