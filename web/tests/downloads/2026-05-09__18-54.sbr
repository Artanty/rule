<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StreamByter-Rules</key>
    <string># StreamByter Script
# Generated: 5/9/2026, 6:54:57 PM

# == RULE 1: [Channel 1] CC#0 → [Channel 1] CC#0 (0) ==
# trigger-source: [channel] "1"
# consumer-source: [channel] "1"
IF M0 == B0 00
  ASS M0 = B0
  ASS M1 = 00
  ASS M2 = 00
  SND M0 M1 M2
  BLOCK
END
</string>
</dict>
</plist>